# 构建产物与发行二进制
*.iso
*.bin
*.xdelta
*.xdelta3
*.zip
*.7z
*.rar
*.exe
*.dll
*.pdb

# 例外：随安装器源码一并发布的、经核验的第三方命令行工具
!installer/third_party/xdelta3-3.2.2/*.exe

# 本地构建与临时目录
build/
dist/
out/
tmp/
tmp_*/
cache/
__pycache__/
*.pyc
*.pyo

# 日志与校验产物的本地副本
*.log
SHA256SUMS.local.txt

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 本地工具（便携版 Git 等）
tools/git/

# 本地预览产物
.preview/
