# 统一换行，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 明确文本类型
*.md      text eol=lf
*.txt     text eol=lf
*.tsv     text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
LICENSE   text eol=lf
NOTICE    text eol=lf

# 明确二进制类型
*.png     binary
*.jpg     binary
*.gif     binary
*.xdelta  binary